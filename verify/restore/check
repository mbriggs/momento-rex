#!/bin/bash
# Model-check momento-rex's restore protocol. See .claude/skills/verify-restore-model/SKILL.md.
#
#   verify/restore/check            conformance, both must-pass models, the findings, sync
#   verify/restore/check --deep     also the overlapping-watcher model at full bounds (~4 min)
#   verify/restore/check --mutants  show each property failing on a broken copy (~30 s)
#   verify/restore/check --sync     record the covered files as described by the model
#
# Needs java 11+ and luajit. Uses $TLA2TOOLS_JAR, or downloads tla2tools 1.7.4
# once into ~/.cache/momento-rex-verify and checks its sha256.
set -u
HERE="$(cd "$(dirname "$0")" && pwd -P)"
ROOT="$(cd "$HERE/../.." && pwd -P)"
T="${TMPDIR:-/tmp}"; OUT="${MOMENTO_REX_VERIFY_OUT:-${T%/}/momento-rex-verify-restore}"
TLA_VERSION=1.7.4
TLA_SHA=936a262061c914694dfd669a543be24573c45d5aa0ff20a8b96b23d01e050e88
COVERED=(lib/momento-rex/core.lua lib/momento-rex/watch.lua)

die() { printf 'check: %s\n' "$*" >&2; exit 2; }
command -v java >/dev/null || die "java is not on PATH (any JDK 11+)"
command -v luajit >/dev/null || die "luajit is not on PATH"

jar() {
  if [ -n "${TLA2TOOLS_JAR:-}" ]; then printf '%s\n' "$TLA2TOOLS_JAR"; return; fi
  local j="$HOME/.cache/momento-rex-verify/tla2tools-$TLA_VERSION.jar"
  if [ ! -f "$j" ]; then
    mkdir -p "${j%/*}"
    curl -fsSL -o "$j.part" "https://github.com/tlaplus/tlaplus/releases/download/v$TLA_VERSION/tla2tools.jar" \
      || die "couldn't download tla2tools $TLA_VERSION; set TLA2TOOLS_JAR"
    mv "$j.part" "$j"
  fi
  [ "$(shasum -a 256 "$j" | cut -d' ' -f1)" = "$TLA_SHA" ] || die "$j is not tla2tools $TLA_VERSION (sha256 mismatch)"
  printf '%s\n' "$j"
}
JAR="$(jar)" || exit 2

# tlc DIR SPEC CFG LOG: run TLC on DIR/SPEC.tla with DIR/CFG.cfg.
tlc() {
  (cd "$1" && java -XX:+UseParallelGC -cp "$JAR" tlc2.TLC -workers auto -deadlock \
     -metadir "$OUT/meta/$3" -config "$3.cfg" "$2.tla") > "$4" 2>&1
}
violated() { sed -n 's/^Error: Invariant \([A-Za-z]*\) is violated.*/\1/p' "$1" | head -1; }
passed() { grep -q "Model checking completed. No error has been found" "$1"; }
states() { sed -n "s/.*, \([0-9]*\) distinct states found.*/\1/p" "$1" | tail -1; }

sha_of() { shasum -a 256 "$ROOT/$1" | cut -d' ' -f1; }

if [ "${1:-}" = --sync ]; then
  {
    echo "# Files the model was last confirmed to describe. Written by 'check --sync'."
    # The sha256 lines are what the check compares; the commit is a pointer.
    head="$(git -C "$ROOT" rev-parse HEAD 2>/dev/null || echo none)"
    if git -C "$ROOT" diff --quiet HEAD -- "${COVERED[@]}" 2>/dev/null; then echo "commit $head"
    else echo "commit $head plus uncommitted changes to the covered files"; fi
    for f in "${COVERED[@]}"; do echo "sha256 $(sha_of "$f") $f"; done
  } > "$HERE/SYNC"
  cat "$HERE/SYNC"
  exit 0
fi

rm -rf "$OUT"; mkdir -p "$OUT/meta"
fail=0

echo "conformance: the model's Decide against lib/momento-rex/core.lua"
tlc "$HERE" DecideTable DecideTable "$OUT/table.out"
if ! luajit "$HERE/conform.lua" "$ROOT" < "$OUT/table.out" > "$OUT/conform.txt"; then
  sed 's/^/  /' "$OUT/conform.txt"; fail=1
  echo "  The code changed and the model didn't. Update Decide in Restore.tla first; the model results below describe the old code."
else
  sed 's/^/  /' "$OUT/conform.txt"
fi

# must pass
for cfg in Restore Handoff; do
  tlc "$HERE" Restore $cfg "$OUT/$cfg.out"
  if passed "$OUT/$cfg.out"; then
    printf 'pass   %-20s all properties hold (%s states)\n' "$cfg" "$(states "$OUT/$cfg.out")"
  else
    fail=1
    inv="$(violated "$OUT/$cfg.out")"
    printf 'FAIL   %-20s %s\n' "$cfg" "${inv:-TLC error, see $OUT/$cfg.out}"
    [ -n "$inv" ] && luajit "$HERE/trace.lua" < "$OUT/$cfg.out" > "$OUT/$cfg.trace" && echo "       trace: $OUT/$cfg.trace"
  fi
done

# known findings: each must still fail on its property, until the code is fixed
FINDINGS=(F1-typed-mid-step:ResumeLandsAtPrompt)
for f in "${FINDINGS[@]}"; do
  cfg="${f%%:*}" want="${f#*:}"
  tlc "$HERE" Restore "$cfg" "$OUT/$cfg.out"
  inv="$(violated "$OUT/$cfg.out")"
  if [ "$inv" = "$want" ]; then
    luajit "$HERE/trace.lua" < "$OUT/$cfg.out" > "$OUT/$cfg.trace"
    printf 'known  %-20s still breaks %s (trace: %s)\n' "$cfg" "$want" "$OUT/$cfg.trace"
  elif passed "$OUT/$cfg.out"; then
    printf 'GONE   %-20s no longer breaks %s: if the code was fixed, retire the finding (SKILL.md)\n' "$cfg" "$want"
    fail=1
  else
    printf 'FAIL   %-20s expected %s, got %s\n' "$cfg" "$want" "${inv:-TLC error, see $OUT/$cfg.out}"
    fail=1
  fi
done

if [ "${1:-}" = --deep ]; then
  sed 's/MaxRestarts  = 1/MaxRestarts  = 2/; s/MaxWatchers  = 3/MaxWatchers  = 4/; s/MaxPids      = 2/MaxPids      = 3/; s/MaxChats     = 2/MaxChats     = 3/; s/MaxTime      = 4/MaxTime      = 5/' \
    "$HERE/Handoff.cfg" > "$OUT/HandoffDeep.cfg"
  cp "$HERE/Restore.tla" "$OUT/"
  tlc "$OUT" Restore HandoffDeep "$OUT/HandoffDeep.out"
  if passed "$OUT/HandoffDeep.out"; then printf 'pass   %-20s (%s states)\n' HandoffDeep "$(states "$OUT/HandoffDeep.out")"
  else printf 'FAIL   %-20s %s\n' HandoffDeep "$(violated "$OUT/HandoffDeep.out")"; fail=1; fi
fi

if [ "${1:-}" = --mutants ]; then
  bash "$HERE/mutants.sh" "$JAR" "$OUT" || fail=1
fi

# sync: has covered code changed since the model was last confirmed?
stale=0
while read -r kind sum file; do
  [ "$kind" = sha256 ] || continue
  if [ ! -f "$ROOT/$file" ] || [ "$(sha_of "$file")" != "$sum" ]; then
    printf 'STALE  %s changed since the last sync\n' "$file"; stale=1
  fi
done < "$HERE/SYNC"
if [ "$stale" = 1 ]; then
  echo "       Read the change against the coverage table in SKILL.md. When the model describes it, run: verify/restore/check --sync"
  fail=1
fi

exit $fail
