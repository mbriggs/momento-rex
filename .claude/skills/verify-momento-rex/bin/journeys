#!/bin/bash
# Variables read only inside check's single-quoted strings look unused.
# shellcheck disable=SC2034
# journeys: every journey in features/, driven through sandbox the way the
# recipes say, one check per sub-feature. `sandbox all` runs this in a clean
# environment and stamps the tree when it exits 0; run it through that, not
# directly. Each journey starts from its own fresh `sandbox up`, and every
# run's evidence lands under $BV_EVIDENCE_ROOT.
set -u

HERE="$(cd "$(dirname "$0")" && pwd -P)"
ROOT="$(cd "$HERE/../../../.." && pwd -P)"
S="$HERE/sandbox"

PASS=0; FAIL=0
ok() { PASS=$((PASS + 1)); printf '  ok   %s\n' "$1"; }
bad() { FAIL=$((FAIL + 1)); printf '  FAIL %s\n' "$1"; [ -n "${2:-}" ] && printf '%s\n' "$2" | sed 's/^/       /'; }
# check ID TEST [CONTEXT]: TEST is evaluated; CONTEXT is printed on failure.
check() { if eval "$2"; then ok "$1"; else bad "$1" "${3:-}"; fi; }

# fresh: a new run, its doctor passing. Ends the previous run first.
fresh() {
  [ -n "${BV_RUN:-}" ] && "$S" down >/dev/null 2>&1
  BV_RUN="$("$S" up | awk '$1 == "run" { print $2 }')"
  export BV_RUN
  if [ -z "$BV_RUN" ] || ! "$S" doctor >/dev/null 2>&1; then bad "sandbox up for $1" "$("$S" doctor 2>&1)"; return 1; fi
  STATE="$BV_RUN/state"
}
cleanup() { [ -n "${BV_RUN:-}" ] && "$S" down >/dev/null 2>&1; }
trap cleanup EXIT

pane() { "$S" pane "$@"; }
type_in() { "$S" type "$@"; }
rec() { "$S" record "$1" 2>/dev/null; }
recf() { rec "$1" | jq -r ".$2 // empty"; }
has_rec() { [ -n "$(recf "$1" chat_id)" ]; }
no_rec() { ! has_rec "$1"; }
chat_changed() { has_rec "$1" && [ "$(recf "$1" chat_id)" != "$2" ]; }
watchers() { pgrep -f "state_dir=$STATE" | wc -l | tr -d ' '; }
watchers_are() { [ "$(watchers)" = "$1" ]; }
# since_restart: the launches lines after the last restart marker.
since_restart() { "$S" launches | awk '/^--- restart/ { n = NR } { l[NR] = $0 } END { for (i = n + 1; i <= NR; i++) print l[i] }'; }
count_since() { since_restart | grep -cF -- "$1"; }
launched() { [ "$(count_since "$1")" -ge 1 ]; }
status_has() { "$S" momento-rex status 2>&1 | grep -q "$1"; }
# screen_has SNAPDIR BLOCK TEXT: the pane's screen, lines joined, holds TEXT.
screen_has() { tr -d '\n' < "$1/screen-${2//:/_}.txt" | grep -qF -- "$3"; }
snap() { "$S" snap "$1"; }
# wait_for SECS CMD...: retry CMD every 0.2s until it succeeds.
wait_for() { local n=$(($1 * 5)); shift; while [ $n -gt 0 ]; do "$@" && return 0; sleep 0.2; n=$((n - 1)); done; return 1; }

echo "install and uninstall"
if fresh install; then
  snap install-start >/dev/null
  check install-line '[ "$(grep -c "momento-rex:managed" "$BV_RUN/init.lua")" = 1 ] && head -2 "$BV_RUN/init.lua" | cmp -s - "$BV_RUN/init.orig"' "$(cat "$BV_RUN/init.lua")"
  check install-backup 'cmp -s "$BV_RUN/init.lua.momento-rex-backup" "$BV_RUN/init.orig"'
  out="$("$S" momento-rex install --no-start 2>&1)"; rc=$?
  check install-idempotent '[ $rc = 0 ] && printf "%s" "$out" | grep -q "already set up" && [ "$(grep -c "momento-rex:managed" "$BV_RUN/init.lua")" = 1 ]' "rc=$rc $out"
  check install-watcher 'watchers_are 1' "$("$S" doctor 2>&1)"
  "$S" rex config reload >/dev/null 2>&1
  check install-watcher-reload 'sleep 2; wait_for 10 watchers_are 1' "$(pgrep -fl "state_dir=$STATE")"
  snap install-after >/dev/null
  "$S" momento-rex uninstall >/dev/null 2>&1
  check uninstall-clean 'cmp -s "$BV_RUN/init.lua" "$BV_RUN/init.orig" && wait_for 10 watchers_are 0' "$(diff "$BV_RUN/init.orig" "$BV_RUN/init.lua"; pgrep -fl "state_dir=$STATE")"
  out="$("$S" momento-rex status 2>&1)"; rc=$?
  check uninstall-status '[ $rc = 1 ] && printf "%s" "$out" | grep -q "NOT set up"' "rc=$rc $out"
  snap uninstall-after >/dev/null
fi

if fresh install-check; then
  printf 'this is not lua(\n' >> "$BV_RUN/init.lua"
  grep -v momento-rex:managed "$BV_RUN/init.lua" > "$BV_RUN/broken"
  cp "$BV_RUN/broken" "$BV_RUN/init.lua"
  out="$("$S" momento-rex install --no-start 2>&1)"; rc=$?
  check install-check '[ $rc = 1 ] && printf "%s" "$out" | grep -q "rex config check" && cmp -s "$BV_RUN/init.lua" "$BV_RUN/broken"' "rc=$rc $out"
  snap install-check >/dev/null
fi

echo "saving chats and status"
if fresh save; then
  out="$("$S" momento-rex status 2>&1)"; rc=$?
  check status-healthy '[ $rc = 0 ] && printf "%s" "$out" | grep -q "watcher.*running" && printf "%s" "$out" | grep -q "init.lua.*set up" && printf "%s" "$out" | grep -q "none saved"' "rc=$rc $out"
  read -r SA BA < <(pane a)
  sleep 1; type_in "$SA" "$BA" claude; sleep 3
  check save-claude-first-message-none 'no_rec $BA' "$(rec "$BA")"
  type_in "$SA" "$BA" hello
  check save-claude-first-message 'wait_for 10 has_rec $BA && [ "$(recf $BA agent)" = claude ] && [ "$(recf $BA state)" = live ] && [ "$(recf $BA cwd)" = "$BV_RUN/work" ]' "$(rec "$BA")"
  ID="$(recf "$BA" chat_id)"
  out="$("$S" momento-rex status 2>&1)"
  check status-chats 'printf "%s" "$out" | grep -F "${BA: -8}" | grep -F claude | grep -F "${ID:0:8}" | grep -F live | grep -qF "$BV_RUN/work"' "$out"
  type_in "$SA" "$BA" /clear
  check save-claude-clear 'wait_for 10 chat_changed $BA $ID'
  NEW="$(recf "$BA" chat_id)"
  d="$(snap save-clear)"
  check save-claude-clear-screen 'screen_has "$d" "$BA" "FAKE cleared $NEW"'
  read -r SB BB < <(pane b)
  sleep 1; type_in "$SB" "$BB" codex; sleep 3
  check save-codex-first-message-none 'no_rec $BB' "$(rec "$BB")"
  type_in "$SB" "$BB" hello
  check save-codex-first-message 'wait_for 10 has_rec $BB && [ "$(recf $BB agent)" = codex ]' "$(rec "$BB")"
  "$S" key "$SA" "$BA" ctrl+z; sleep 4
  check save-suspend 'has_rec $BA && [ "$("$S" fg "$SA" "$BA")" = zsh ]' "$(rec "$BA"; "$S" fg "$SA" "$BA")"
  snap save-suspend >/dev/null
  type_in "$SA" "$BA" fg; sleep 1; type_in "$SA" "$BA" /exit
  check save-exit 'wait_for 10 no_rec $BA' "$(rec "$BA")"
  read -r SC BC < <(pane c)
  sleep 1; type_in "$SC" "$BC" claude; sleep 1; type_in "$SC" "$BC" hello
  wait_for 10 has_rec "$BC"
  "$S" rex kill "$SC" >/dev/null 2>&1
  check save-gc 'wait_for 15 no_rec $BC' "$(rec "$BC")"
  snap save-after >/dev/null
fi

echo "restore after restart"
if fresh restore; then
  read -r SA BA < <(pane a)
  sleep 1; type_in "$SA" "$BA" claude; sleep 2; type_in "$SA" "$BA" hello
  wait_for 10 has_rec "$BA"; ID="$(recf "$BA" chat_id)"
  QDIR="$BV_RUN/it's dir"
  read -r SB BB < <(pane b "$QDIR")
  sleep 1; type_in "$SB" "$BB" codex; sleep 2; type_in "$SB" "$BB" hello
  wait_for 10 has_rec "$BB"; IDB="$(recf "$BB" chat_id)"
  read -r SD BD < <(pane d)
  check restore-preconditions '[ -n "$ID" ] && [ "$(recf $BB cwd)" = "$QDIR" ] && [ "$("$S" fg "$SD" "$BD")" = zsh ]' "$(rec "$BA"; rec "$BB")"
  snap restore-before >/dev/null
  "$S" restart >/dev/null
  wait_for 15 launched "claude resumed $ID"; wait_for 15 launched "codex resumed $IDB"
  sleep 4
  d="$(snap restore-after)"
  check restore-claude '[ "$("$S" fg "$SA" "$BA")" = claude ] && screen_has "$d" "$BA" "claude --resume $ID"' "$(since_restart)"
  check restore-alias '[ "$(count_since "claude resumed $ID cwd=$BV_RUN/work alias=1")" = 1 ]' "$(since_restart)"
  check restore-codex '[ "$(count_since "codex resumed $IDB cwd=$QDIR")" = 1 ] && screen_has "$d" "$BB" "codex resume $IDB"' "$(since_restart)"
  check restore-once '[ "$(since_restart | wc -l | tr -d " ")" = 2 ]' "$(since_restart)"
  check restore-none '[ "$("$S" fg "$SD" "$BD")" = zsh ] && ! grep -qE "resume|FAKE" "$d/screen-${BD//:/_}.txt"' "$(cat "$d/screen-${BD//:/_}.txt")"
  "$S" restart >/dev/null
  check restore-codex-unmessaged 'wait_for 15 launched "codex resumed $IDB"' "$(since_restart)"
  wait_for 15 launched "claude resumed $ID"
  sleep 4
  before="$("$S" launches | wc -l | tr -d ' ')"
  old="$(tr -d ' \n' < "$STATE/watcher.token")"
  sock="$(grep "^SOCK=" "$BV_RUN/run.env" | cut -d= -f2-)"
  # What `momento-rex start` runs. The CLI refuses start in a lane, so the
  # run starts the replacement watcher itself, against this run's server.
  # `do` is rex's subcommand here, not the shell keyword.
  # shellcheck disable=SC1010
  ( MOMENTO_REX_PERIOD=1 MOMENTO_REX_GC_AFTER=6 nohup rex -S "$sock" --autostart=false do "$ROOT/lib/momento-rex/watch.lua" --all "state_dir=$STATE" >/dev/null 2>&1 </dev/null & )
  took_over() { t="$(tr -d ' \n' < "$STATE/watcher.token")"; [ "$t" != "$old" ] && [ "$(jq -r .token "$STATE/status.json" 2>/dev/null)" = "$t" ] && watchers_are 1; }
  wait_for 15 took_over
  sleep 5
  check restore-watcher-only 'took_over && [ "$("$S" launches | wc -l | tr -d " ")" = "$before" ]' "$("$S" launches; pgrep -fl "state_dir=$STATE")"
  snap restore-watcher-only >/dev/null
fi

echo "status problems"
if fresh status; then
  read -r SD BD < <(pane d)
  bad_id="11111111-2222-3333-4444-555555555555"
  mkdir -p "$STATE/panes"
  jq -cn --arg b "$BD" --arg s "$SD" --arg id "$bad_id" --arg cwd "/tmp/x
touch $BV_RUN/pwned" '{v:1,agent:"claude",chat_id:$id,cwd:$cwd,inc:"1@old",agent_pid:1,agent_start:"x",session_id:$s,block_id:$b,state:"live"}' \
    > "$STATE/panes/${BD//:/_}.json"
  "$S" restart >/dev/null
  check status-unsafe-refused 'wait_for 10 sh -c "! [ -f \"$STATE/panes/${BD//:/_}.json\" ]"'
  sleep 1
  out="$("$S" momento-rex status 2>&1)"; rc=$?
  check status-unsafe '[ ! -e "$BV_RUN/pwned" ] && ! "$S" launches | grep -qF "$bad_id" && [ $rc = 1 ] && printf "%s" "$out" | grep -q resume.unsafe' "rc=$rc $out"
  snap status-unsafe >/dev/null
  read -r SE BE < <(pane e)
  sleep 1; type_in "$SE" "$BE" "FAKE_CLAUDE_V2=1 claude"
  check status-drift 'wait_for 20 status_has claude.sessions' "$("$S" momento-rex status 2>&1)"
  snap status-drift >/dev/null
  read -r SA BA < <(pane a)
  sleep 1; type_in "$SA" "$BA" claude; sleep 2; type_in "$SA" "$BA" hello
  wait_for 10 has_rec "$BA"
  "$S" stop
  out="$("$S" momento-rex status 2>/dev/null)"; rc=$?
  check status-no-rex '[ $rc = 4 ] && printf "%s" "$out" | grep -q "Rex isn.t running" && printf "%s" "$out" | grep -qF "saved: ${BA//:/_}.json"' "rc=$rc $out"
  snap status-no-rex >/dev/null
fi

printf '\n%d passed, %d failed\n' "$PASS" "$FAIL"
[ "$FAIL" = 0 ]
